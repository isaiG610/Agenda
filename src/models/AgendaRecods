class AgendaRecords {
    constructor(eventName, eventDate, eventTime, eventDescription) {
        this.eventName = eventName;
        this.eventDate = eventDate;
        this.eventTime = eventTime;
        this.eventDescription = eventDescription;
    }
    schedule() {
        if(this.eventName === "" || this.eventDate === "" || this.eventTime === "" || this.eventDescription === "") {
            console.log("Please fill in all the form fields.");
            return;
        }
        
    }
}