class RegistrosAgenda {
    constructor(Nombre_eventos, Fecha_eventos, Hora_eventos, Descripcion_eventos) {
        this.Nombre_eventos = Nombre_eventos;
        this.Fecha_eventos = Fecha_eventos;
        this.Hora_eventos = Hora_eventos;
        this.Descripcion_eventos = Descripcion_eventos;
    }
    agendar() {
        if(this.Nombre_eventos === "" || this.Fecha_eventos === "" || this.Hora_eventos === "" || this.Descripcion_eventos === "") {
            console.log("Por favor, complete todos los campos del formulario.");
            return;
        }
        
    }
}